--- a/include/leapc_cells.inc
+++ b/include/leapc_cells.inc
@@ -178,6 +178,7 @@
 SH_HEIGHTS:     DEFS SH_VIEW_MAX    ; SH_VIEW: the screen rows of each line above the cursor line
 SH_STATUS_BUF:  DEFS 33             ; the status row's text (32 characters and the NUL)
 SH_REPORT_BUF:  DEFS 33             ; Phase 6: a report's first row (row 22: SH_REPORT)
+SH_ERR_COL:     DEFS 2              ; a compile error's column, applied once by SH_LOAD_EDIT
 SH_IMAGE_SIZE:  DEFS 2              ; Phase 6: the size of the last image compiled (SH_IMAGE; FREE)
 
 ; ---- tape (Phase 7: the shell's SAVE, LOAD, VERIFY and the library's tape_save, tape_load; spec.md 8). The
--- a/src/shell/shell.asm
+++ b/src/shell/shell.asm
@@ -210,7 +210,7 @@
     pop  hl
     call SH_APPEND_NUM
     call SH_MEMORY                     ; "IMAGE i B  HEAP h B"
-    jr   SH_REPORT
+    jp   SH_REPORT
 .failed:                               ; A = the runtime error
     ld   b, a
     ld   hl, SH_MSG_BREAK
@@ -237,6 +237,30 @@
     or   l
     jr   z, SH_REPORT
     call SH_JUMP_TO_LINE               ; the cursor on the line, its text in the edit buffer
+    ld   a, (CC_ERRNUM)                ; a compile error: the cursor on the token it stopped at (TOK_PTR),
+    or   a                             ; or at the line's end when that token is past it (a missing `;`)
+    jr   z, .nocol
+    call SH_POS_IS_APPEND
+    jr   z, .nocol
+    ld   c, (hl)
+    inc  hl
+    ld   b, (hl)
+    inc  hl                            ; HL = the line's text, BC = its length and the CR
+    dec  bc
+    ex   de, hl
+    ld   hl, (TOK_PTR)
+    or   a
+    sbc  hl, de                        ; the token's column (before the line: a large number)
+    push hl
+    sbc  hl, bc
+    pop  hl
+    jr   c, .col
+.eol:
+    ld   h, b
+    ld   l, c
+.col:
+    ld   (SH_ERR_COL), hl              ; (SH_LOAD_EDIT puts the cursor there when the editor resumes)
+.nocol:
     ld   de, SH_STATUS_BUF
     ld   hl, SH_TXT_LINE               ; "LINE "
     call SH_APPEND
@@ -650,8 +674,10 @@
     ld   (de), a
     call SH_POS_IS_APPEND
     call nz, SH_COPY_TEXT
-    ld   hl, 0
+    ld   hl, (SH_ERR_COL)              ; the cursor at 0, or once at a compile error's column
     ld   (EDIT_BUF_OFFSET), hl
+    ld   hl, 0
+    ld   (SH_ERR_COL), hl
     ret
 
