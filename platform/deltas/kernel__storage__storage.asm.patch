--- a/kernel/storage/storage.asm
+++ b/kernel/storage/storage.asm
@@ -233,6 +233,11 @@
 STORAGE_LEADER_PILOT EQU $9C    ; LD-LEADER M0126 — initial timing
                                  ; value for the leader-tone search.
 
+; LEAP-C DELTA D9 (Phase 7): the block I/O (STORAGE_SEND_BLOCK, STORAGE_RECEIVE_BLOCK) is
+; assembled in the HOME ROM only (STORAGE_NO_BLOCKS leaves it out of the EXROM), and the
+; header logic from STORAGE_VERSION_WORD on in the EXROM only (STORAGE_BLOCKS_ONLY leaves it
+; out of the HOME), so data blocks can move with chunk 6 paged out (spec.md 8.3).
+    IFNDEF STORAGE_NO_BLOCKS
 ; ============================================================================
 ; STORAGE_SEND_BLOCK — ported from the real ROM's SA-BYTES (+ SA-FLAG/
 ; SA-LEADER/SA-SYNC-1/SA-SYNC-2/SA-LOOP/SA-LOOP-P/SA-START/SA-PARITY/
@@ -589,7 +594,9 @@
     out  (PORT_ULA), a
     ret
     ENDIF
+    ENDIF ; STORAGE_NO_BLOCKS (D9)
 
+    IFNDEF STORAGE_BLOCKS_ONLY ; (D9)
     IFDEF STORAGE_VERSIONED
 ; ============================================================================
 ; STORAGE_VERSION_WORD (R10.9)
@@ -610,18 +617,14 @@
 ; ============================================================================
 ; STORAGE_SAVE
 ; In:  HL = filename pointer, B = filename length, IX = data pointer,
-;      DE = data length
+;      DE = data length (Leap-C, delta D18: B = STORAGE_HEADER_FILENAME_LEN,
+;      the name already padded with spaces; the clamp and the padding are gone)
 ; Out: carry always clear (this project's own caller ignores it anyway
 ;      — see rom/exrom_storage.asm's own header)
 ; Destroys: AF, BC, DE, HL, IX
 ; ============================================================================
 STORAGE_SAVE:
     di
-    ld   a, b
-    cp   STORAGE_HEADER_FILENAME_LEN + 1
-    jr   c, .name_len_ok
-    ld   b, STORAGE_HEADER_FILENAME_LEN   ; transport field is fixed-width
-.name_len_ok:
     push ix
     push de
     ld   (STORAGE_SEND_LEN), de           ; stash the caller's own data
@@ -653,16 +656,6 @@
     djnz .name_copy
     pop  bc
 .name_done:
-    ld   a, STORAGE_HEADER_FILENAME_LEN
-    sub  b
-    jr   z, .len_set
-    ld   b, a
-    ld   a, ' '
-.pad:
-    ld   (de), a
-    inc  de
-    djnz .pad
-.len_set:
     ld   hl, (STORAGE_SEND_LEN)
     ld   (STORAGE_HEADER_BUF + STORAGE_HEADER_LENGTH_OFF), hl
     IFDEF STORAGE_VERSIONED
@@ -1066,3 +1059,4 @@
     ret
 .call_hl:
     jp   (hl)
+    ENDIF ; STORAGE_BLOCKS_ONLY (D9)
