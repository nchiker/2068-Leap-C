--- a/kernel/storage/storage.asm
+++ b/kernel/storage/storage.asm
@@ -1,3 +1,20 @@
+; ============================================================================
+; kernel/storage/storage.asm -- tape SAVE/LOAD: the header logic (V2's)
+;
+; The stock TS2068/Sinclair two-block format: one header block (flag $00: the
+; 17-byte header, see the offsets below) followed by one data block (flag $FF)
+; holding the program or the data, each ending in its XOR checksum.
+;
+; LEAP-C DELTA D20 (Phase 11, M11-tape): V2's block I/O (STORAGE_SEND_BLOCK and
+; STORAGE_RECEIVE_BLOCK, with their timing constants and this file's former
+; header describing them) was a port of the stock ROM's tape routines and is
+; removed. The block I/O is Leap-C's own clean-room code, written from
+; docs/TAPE_SIGNAL_SPEC.md (src/kernel/tapeblock.asm, in HOME: TAPE_SEND_BLOCK,
+; TAPE_RECV_BLOCK); the EXROM's STORAGE_SAVE and STORAGE_LOAD below reach it
+; under these names through TAPE_BLOCK (src/rom/exrom.asm, src/shell/tape.asm).
+; The removed text is recorded by hash only (platform/deltas/
+; kernel__storage__storage.asm.cut; tools/check_platform.py).
+; ============================================================================
 
 STORAGE_TYPE_HEADER EQU $00   ; SA-BYTES/LD-BYTES type-flag byte — this
                                ; is the value LD-LOOK-H's own real code
@@ -79,6 +96,7 @@
                                ; copy search when there's no real second
                                ; copy left to find).
 
+    IFNDEF STORAGE_BLOCKS_ONLY ; (D9)
     IFDEF STORAGE_VERSIONED
 ; ============================================================================
 ; STORAGE_VERSION_WORD (R10.9)
@@ -99,18 +117,14 @@
 ; ============================================================================
 ; STORAGE_SAVE
 ; In:  HL = filename pointer, B = filename length, IX = data pointer,
-;      DE = data length
+;      DE = data length (Leap-C, delta D18: B = STORAGE_HEADER_FILENAME_LEN,
+;      the name already padded with spaces; the clamp and the padding are gone)
 ; Out: carry always clear (this project's own caller ignores it anyway
 ;      — see rom/exrom_storage.asm's own header)
 ; Destroys: AF, BC, DE, HL, IX
 ; ============================================================================
 STORAGE_SAVE:
     di
-    ld   a, b
-    cp   STORAGE_HEADER_FILENAME_LEN + 1
-    jr   c, .name_len_ok
-    ld   b, STORAGE_HEADER_FILENAME_LEN   ; transport field is fixed-width
-.name_len_ok:
     push ix
     push de
     ld   (STORAGE_SEND_LEN), de           ; stash the caller's own data
@@ -142,16 +156,6 @@
     djnz .name_copy
     pop  bc
 .name_done:
-    ld   a, STORAGE_HEADER_FILENAME_LEN
-    sub  b
-    jr   z, .len_set
-    ld   b, a
-    ld   a, ' '
-.pad:
-    ld   (de), a
-    inc  de
-    djnz .pad
-.len_set:
     ld   hl, (STORAGE_SEND_LEN)
     ld   (STORAGE_HEADER_BUF + STORAGE_HEADER_LENGTH_OFF), hl
     IFDEF STORAGE_VERSIONED
@@ -555,3 +559,4 @@
     ret
 .call_hl:
     jp   (hl)
+    ENDIF ; STORAGE_BLOCKS_ONLY (D9)
