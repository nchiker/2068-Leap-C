--- a/kernel/interrupt/interrupt.asm
+++ b/kernel/interrupt/interrupt.asm
@@ -200,14 +200,18 @@
     ld   (FRAMES), hl                  ; once, before any of this
                                       ; routine's own early-exit paths
 
+    ld   a, (KBD_CUR_ROW)              ; LEAP-C DELTA D27 (2068-Forth v2.0's interrupt): with no key
+    inc  a                             ; tracked ($FF + 1 = 0 selects every row at once), one read
+    jr   nz, .tracked                  ; of the keyboard ends an idle frame: bits 0-4 all set = no
+    in   a, (PORT_ULA)                 ; key down (V2 scanned all 8 rows every frame: about 2,000 T)
+    or   $E0
+    inc  a
+    jr   z, .done
+    call IO_KEY_SCAN_ALL
+    jr   .look_for_new
+.tracked:                              ; something is tracked: the rows, then that key
     call IO_KEY_SCAN_ALL
-
     ld   a, (KBD_CUR_ROW)
-    cp   $FF
-    jr   z, .look_for_new           ; nothing currently tracked
-
-    ; something is tracked -- check ONLY that key, regardless of
-    ; anything else currently down on the matrix
     ld   b, a
     ld   a, (KBD_CUR_BIT)
     ld   c, a
@@ -237,19 +241,15 @@
     ; debounce just reached 0 -- accept and latch, start repeat timer
     call IO_DECODE_KEY
     ld   (KBD_LASTK), a
-    IFDEF V2_PRODUCTION
-    cp   KEY_BREAK                     ; STUDY (D5): BREAK halts a running
-    jr   nz, .not_break                ; program at the next dispatch --
-    ld   a, 66                         ; VM_RUN.loop already tests VM_HALTED
-    ld   (VM_ERROR_CODE), a            ; before every opcode, so no poll is
-    ld   a, 1                          ; added to the VM. VM_INIT clears both
-    ld   (VM_HALTED), a                ; cells at the next RUN, so a stale
-.not_break:                            ; request raised in the editor is inert
-    ENDIF
+    sub  KEY_BREAK                     ; LEAP-C (D4): B = 0 for BREAK (B is
+    ld   b, a                          ; restored by the pops at .done)
     ld   a, $FF
     ld   (KBD_KEYHIT), a
     ld   a, KBD_REPDEL
     ld   (KBD_REPEAT), a
+    ld   a, b                          ; LEAP-C (D4): BREAK stops a running C
+    or   a                             ; program (spec.md 5.8): the runtime
+    call z, RT_BREAKREQ                ; unwinds it unless it defers BREAK
     jr   .done
 
 .already_accepted:
